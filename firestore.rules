rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // 1. Users Collection
    match /users/{userId} {
      // Any authenticated user can read profiles (e.g., coordinator checking volunteer details)
      allow read: if isAuthenticated();

      // Users can only create their own profile document
      // Ordinary users cannot assign themselves admin role without bootstrap verification
      allow create: if isOwner(userId) && 
        (request.resource.data.role != 'admin' || request.resource.data.isAdminBootstrapVerified == true);

      // Users can update their name, phone, skills, and location
      // Role and admin verification flags cannot be modified client-side
      allow update: if isOwner(userId) && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.isAdminBootstrapVerified == resource.data.isAdminBootstrapVerified;

      allow delete: if isAdmin();
    }

    // 2. Relief Requests Collection
    match /relief_requests/{requestId} {
      // Anyone logged in can read relief requests to see where aid is needed
      allow read: if isAuthenticated();

      // Affected individuals can create their own relief request
      allow create: if isAuthenticated() && 
        request.resource.data.requesterId == request.auth.uid;

      // The original requester can update their request while it is still pending
      // Admins/coordinators can update status and remarks at any time
      allow update: if (isAuthenticated() && resource.data.requesterId == request.auth.uid && resource.data.status == 'Pending')
                    || isAdmin();

      // Requesters can withdraw/delete their pending request; Admins can purge
      allow delete: if (isAuthenticated() && resource.data.requesterId == request.auth.uid) || isAdmin();
    }

    // 3. Relief Tasks Collection
    match /relief_tasks/{taskId} {
      // Volunteers and the public can view active relief operations
      allow read: if isAuthenticated();

      // Only authorized administrators/coordinators can publish, update, or cancel tasks
      allow create, update, delete: if isAdmin();
    }

    // 4. Task Participants Collection
    match /task_participants/{participantId} {
      allow read: if isAuthenticated();

      // Volunteers can only register themselves for a task
      allow create: if isAuthenticated() && 
        request.resource.data.volunteerId == request.auth.uid;

      // Volunteers can withdraw (cancel) their own application;
      // Coordinators/admins can approve, complete, or reject any participant
      allow update: if (isAuthenticated() && resource.data.volunteerId == request.auth.uid && request.resource.data.status == 'Cancelled')
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // 5. Activity Logs Collection
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
